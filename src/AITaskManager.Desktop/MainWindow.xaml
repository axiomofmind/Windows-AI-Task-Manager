<Window x:Class="AITaskManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Task Manager"
        Icon="Assets/aitaskmanager.ico"
        Width="1440"
        Height="920"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#080C12">
    <Grid>
        <wv2:WebView2 x:Name="DashboardView"
                      DefaultBackgroundColor="#080C12" />

        <Border x:Name="StartupOverlay"
                Background="#080C12"
                Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="AI TASK MANAGER"
                           Foreground="#DCEBFF"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="StartupStatus"
                           Text="INITIALIZING SYSTEMS"
                           Foreground="#63C7FF"
                           FontFamily="Consolas"
                           FontSize="13"
                           Margin="0,14,0,18"
                           HorizontalAlignment="Center" />
                <ProgressBar Width="280"
                             Height="3"
                             IsIndeterminate="True"
                             Foreground="#33B5E5"
                             Background="#172334" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
